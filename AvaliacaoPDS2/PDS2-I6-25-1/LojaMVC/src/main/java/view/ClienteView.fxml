      <Label layoutX="23.0" layoutY="135.0" text="Endereço" />
      <Label layoutX="23.0" layoutY="166.0" text="Data de Nascimento" />
      <TextField fx:id="txtNome" layoutX="89.0" layoutY="66.0" prefHeight="25.0" prefWidth="449.0" />
      <TextField fx:id="txtTelefone" layoutX="89.0" layoutY="100.0" prefHeight="25.0" prefWidth="449.0" />
      <TextField fx:id="txtEndereco" layoutX="89.0" layoutY="131.0" prefHeight="25.0" prefWidth="449.0" />
